rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validNameAndEmail(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.createdAt == request.time;
    }

    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'subject', 'message', 'createdAt'
        ])
        && validNameAndEmail(request.resource.data)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if false;
    }

    match /trainingSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'course', 'level', 'createdAt'
        ])
        && validNameAndEmail(request.resource.data)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.course is string
        && request.resource.data.course.size() > 0
        && request.resource.data.course.size() <= 160
        && request.resource.data.level is string
        && request.resource.data.level.size() <= 100;
      allow read, update, delete: if false;
    }
  }
}
